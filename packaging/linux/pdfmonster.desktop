[Desktop Entry]
Type=Application
Name=pdfmonster
GenericName=PDF Scan Straightener
Comment=Straightens crooked pages in scanned PDFs
Exec=pdfmonster %f
Icon=pdfmonster
Terminal=false
Categories=Graphics;Scanning;
MimeType=application/pdf;
Keywords=pdf;scan;deskew;straighten;rotate;
StartupWMClass=pdfmonster
